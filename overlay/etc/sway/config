# AetherOS Sway configuration (system-wide default).
# Copy to ~/.config/sway/config to customise. Reload with $mod+Shift+c.
#
# $mod is the Super (Windows) key. If your VM host captures it, change the next
# line to "Mod1" (Alt) instead.
set $mod Mod4
set $term foot
set $menu fuzzel
set $browser firefox-esr
set $files thunar

# ---- Look --------------------------------------------------------------
set $bg      #0f1117
set $surface #171a23
set $text    #e6e9f2
set $muted   #8b93a7
set $accent  #8ab4ff
set $urgent  #ff7a90

font pango:Inter 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 4
smart_gaps off
smart_borders no_gaps
hide_edge_borders none

#                        border    background text     indicator child_border
client.focused           $accent   $surface   $text    $accent   $accent
client.focused_inactive  #2a2f3d   $surface   $muted   #2a2f3d   #2a2f3d
client.unfocused         #1b1f2b   $bg        $muted   #1b1f2b   #1b1f2b
client.urgent            $urgent   $surface   $text    $urgent   $urgent
client.placeholder       $bg       $bg        $muted   $bg       $bg
client.background        $bg

output * bg /usr/share/backgrounds/aether/aurora.png fill #0f1117
seat * xcursor_theme Adwaita 24

input type:keyboard {
    xkb_layout us
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

floating_modifier $mod normal
focus_follows_mouse yes

# ---- Core keys ---------------------------------------------------------
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+space exec aether-assistant
bindsym $mod+b exec $browser
bindsym $mod+e exec $files
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit the AetherOS desktop?' -B 'Yes, exit' 'swaymsg exit'
bindsym $mod+Ctrl+l exec swaylock -f -c 0f1117

# ---- Focus and layout --------------------------------------------------
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+v splitv
bindsym $mod+g splith
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Tab focus mode_toggle

# ---- Workspaces --------------------------------------------------------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6

# ---- Resize mode -------------------------------------------------------
mode "resize" {
    bindsym Left resize shrink width 40px
    bindsym Down resize grow height 40px
    bindsym Up resize shrink height 40px
    bindsym Right resize grow width 40px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ---- Media keys, screenshots ------------------------------------------
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym Print exec sh -c 'mkdir -p "$HOME/Pictures" && grim "$HOME/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png" && notify-send "Screenshot saved" "~/Pictures"'
bindsym $mod+Print exec sh -c 'mkdir -p "$HOME/Pictures" && grim -g "$(slurp)" "$HOME/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png" && notify-send "Screenshot saved" "~/Pictures"'

# ---- Window rules ------------------------------------------------------
for_window [app_id="os.aether.Assistant"] floating enable, border pixel 2, resize set 760 660, move position center
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="calamares"] floating enable
for_window [class="calamares"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

# ---- Bar and background services --------------------------------------
# The bar, notifications and audio are started from here; each is optional and
# a missing program simply does nothing.
exec_always --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland
exec --no-startup-id waybar
exec --no-startup-id mako
exec --no-startup-id nm-applet --indicator
exec --no-startup-id swayidle -w timeout 900 'swaylock -f -c 0f1117' before-sleep 'swaylock -f -c 0f1117'
exec --no-startup-id sh -c 'sleep 2; notify-send "Welcome to AetherOS" "Super+Space: assistant   Super+D: apps   Super+Enter: terminal"'
